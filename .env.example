# Copy this file to .env and replace each placeholder with your own value.
# The three keys authenticate requests from the client, and never enter a sandbox.
RENDER_API_KEY=replace-with-your-render-api-key
# This non-secret ID selects the Render workspace where paid sandboxes are created.
RENDER_WORKSPACE_ID=tea-replace-with-your-workspace-id
EXA_API_KEY=replace-with-your-exa-api-key
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Keep this model to reproduce the documented comparison.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
